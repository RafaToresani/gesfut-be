# Ejemplo de configuracion de Gesfut backend. NO poner valores reales aca.
# Copiar a application-local.properties (no se commitea) o exportar como variables de entorno.
DB_NAME=jdbc:mysql://localhost:3306/gesfut_ejemplo
DB_USERNAME=usuario_ejemplo
DB_PASSWORD=cambiar_esto
# Clave HMAC del JWT en base64 (minimo 256 bits). Generar una propia; nunca reusar la de otro entorno.
SECRET.KEY=generar_una_clave_base64_propia
FE_URL=http://localhost:4200
EMAIL_PORT=587
EMAIL_USER=cuenta_ejemplo@example.com
EMAIL_PASS=cambiar_esto
# Mail de verificacion al registrarse (false = cuenta verificada automaticamente, sin mail).
gesfut.mail.verificacion.enabled=false
# Swagger solo en desarrollo.
app.security.swagger-public=false
# Flyway apagado por defecto: solo true en el arranque que migra la base (con backup y prueba en copia antes).
FLYWAY_ENABLED=false
